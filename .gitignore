build/
build-*/
_deps/
compile_commands.json
CMakeUserPresets.json
*.o
*.a
*.so

# Benchmark results are NOT ignored: bench/results/ is committed so that any
# number quoted anywhere can be traced back to the run that produced it.
# The generated report is ignored, since it is derived from those results.
bench/report.html

